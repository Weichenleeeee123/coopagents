# Copy to .env; use a real DNS name pointing at the deployment server.
CREWMESH_DOMAIN=crewmesh.example.com
CREWMESH_VERSION=0.4.0rc1
CREWMESH_MODE=self-hosted
# Generate a new random secret locally; never commit its file.
CREWMESH_BOOTSTRAP_FILE=./.local/bootstrap-secret.txt
# Optional GitHub App: used only with compose.github.yaml. Supply real values in .env.
# CREWMESH_GITHUB_APP_ID=
# CREWMESH_GITHUB_APP_CLIENT_ID=
# CREWMESH_GITHUB_APP_CLIENT_SECRET_PATH=./.local/github-client-secret.txt
# CREWMESH_GITHUB_APP_PRIVATE_KEY_PATH=./.local/github-app-private-key.pem
# CREWMESH_GITHUB_WEBHOOK_SECRET_PATH=./.local/github-webhook-secret.txt

# Optional official-cloud account OAuth + Stripe subscription overlay.
# Enable ONLY via -f compose.yaml -f deploy/compose.cloud-billing.yaml.
# Leave ALL billing variables absent for an unlimited cloud without subscriptions.
# Account OAuth is independent of the read-only GitHub App above.
# CREWMESH_GITHUB_CLIENT_ID=
# CREWMESH_GITHUB_CLIENT_SECRET_PATH=./.local/github-oauth-secret.txt
# CREWMESH_BILLING_MODE=                   # explicitly test or live
# CREWMESH_STRIPE_SECRET_KEY_PATH=./.local/stripe-secret-key.txt
# CREWMESH_STRIPE_WEBHOOK_SECRET_PATH=./.local/stripe-webhook-secret.txt
# CREWMESH_TEAM_MONTHLY_PRICE_ID=          # real matching-mode fixed monthly Price
# CREWMESH_FREE_MEMBERS=                   # explicit positive integer, no preset cap
# CREWMESH_FREE_PROJECTS=
# CREWMESH_TEAM_MEMBERS=                   # at least Free members
# CREWMESH_TEAM_PROJECTS=                  # at least Free projects
# No monetary amount is configured here: the server verifies the actual Price.
# Protect each secret directory; secret files must be readable by container UID 10001.
# See docs/c2-operations.md before enabling billing; C3/real-provider acceptance is pending.
